# Salin menjadi `.env` di root project, lalu ganti semua nilai rahasia.
# File `.env` tidak di-commit; file contoh ini boleh di-commit karena tidak berisi rahasia asli.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=gantipasswordini
POSTGRES_DB=app_db
BACKEND_PORT=3000
DB_PORT=5432
# Hanya untuk menjalankan backend/test tanpa Docker; samakan dengan nilai di atas
DATABASE_URL=postgres://app:gantipasswordini@localhost:5432/app_db

# --- CORS ---
CORS_ORIGIN=*

# --- Auth (FR-01) ---
# Wajib diisi, dan keduanya harus berbeda. Buat nilai acak, misalnya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Opsional (dalam detik). Default: access 900 (15 menit), refresh 604800 (7 hari).
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
# Opsional. Maksimal percobaan register/login per IP per 15 menit (default 10).
AUTH_RATE_LIMIT_MAX=
# Opsional. Jumlah reverse proxy di depan backend saat di-deploy (default 0, biasanya 1 di cloud).
TRUST_PROXY=

# --- Kurs (FR-05), semuanya opsional ---
EXCHANGE_RATE_API_BASE_URL=
EXCHANGE_RATE_BASE_CURRENCY=
EXCHANGE_RATE_TRACKED_CURRENCIES=
EXCHANGE_RATE_CRON_SCHEDULE=
INTERNAL_CRON_SECRET=
